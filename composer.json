{
    "name": "innoboxrr/routes-to-json",
    "description": "A partir de las rutas del sistema, laravel crea un archivo json en la ubicación especificada en el archivo de configuración para que sean resueltas en el frontend por el paquete route-resolver",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\RoutesToJson\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\RoutesToJson\\Providers\\RoutesToJsonServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "innoboxrr/larapack-generator": "^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\RoutesToJson\\Tests\\": "tests/"
        }
    }
}
